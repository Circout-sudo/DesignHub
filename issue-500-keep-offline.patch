@@ -0,0 +1,86 @@
+import { describe, expect, test } from "vitest";
+
+import { keepStudio, keepStudios, summarize, type KeepResult } from "@/lib/pwa/keep-studios";
+
+const done = (pathname: string, extra: Partial<KeepResult> = {}): KeepResult => ({
+  pathname,
+  status: "kept",
+  files: 2,
+  bytes: 1000,
+  failed: 0,
+  full: false,
+  ...extra,
+});
+
+/** A worker that answers each message on the port it was sent, or says nothing when `reply` returns undefined. */
+function worker(reply: (pathname: string) => unknown) {
+  const asked: string[] = [];
+  return {
+    asked,
+    postMessage(message: { type: string; pathname: string }, ports: MessagePort[]) {
+      asked.push(`${message.type} ${message.pathname}`);
+      const answer = reply(message.pathname);
+      if (answer !== undefined) ports[0]?.postMessage(answer);
+    },
+  };
+}
+
+describe("keeping studios from the page", () => {
+  test("sends one message per studio, one after the other, and reports progress and the size so far", async () => {
+    const fake = worker((pathname) => done(pathname, { bytes: pathname.length * 100 }));
+    const progress: { current: number; total: number; bytes: number }[] = [];
+    const results = await keepStudios(fake as never, ["/colors", "/svg"], (step) => progress.push(step));
+    expect(fake.asked).toEqual(["REMEMBER_ROUTE /colors", "REMEMBER_ROUTE /svg"]);
+    expect(progress).toEqual([
+      { current: 1, total: 2, bytes: 0 },
+      { current: 2, total: 2, bytes: 700 },
+    ]);
+    expect(results.map((result) => result.pathname)).toEqual(["/colors", "/svg"]);
+  });
+
+  test("a worker that does not answer is reported as silent after the timeout", async () => {
+    const result = await keepStudio(worker(() => undefined) as never, "/colors", 20);
+    expect(result).toMatchObject({ pathname: "/colors", status: "silent", files: 0, bytes: 0 });
+  });
+
+  test("a worker that cannot be messaged is reported as silent", async () => {
+    const broken = {
+      postMessage: () => {
+        throw new Error("gone");
+      },
+    };
+    expect((await keepStudio(broken as never, "/colors", 20)).status).toBe("silent");
+  });
+
+  test("an answer of the wrong shape is a failure, never a crash", async () => {
+    expect((await keepStudio(worker(() => ({ status: 3, files: "many", bytes: -4 })) as never, "/a")).status).toBe(
+      "failed",
+    );
+    expect((await keepStudio(worker(() => ({ status: "kept", files: "many", bytes: -4 })) as never, "/a")).bytes).toBe(
+      0,
+    );
+    expect((await keepStudio(worker(() => "text") as never, "/a")).status).toBe("silent");
+  });
+});
+
+describe("summarize", () => {
+  test("counts the studios that are ready and the bytes added", () => {
+    expect(summarize([done("/a"), done("/b", { bytes: 500 })])).toEqual({
+      kept: 2,
+      bytes: 1500,
+      notReady: [],
+      silent: [],
+      full: false,
+    });
+  });
+
+  test("names what did not fit, what failed and what did not answer", () => {
+    const summary = summarize([
+      done("/a"),
+      done("/b", { status: "failed", files: 1, bytes: 300, failed: 2, full: true }),
+      done("/c", { status: "unknown", files: 0, bytes: 0 }),
+      done("/d", { status: "silent", files: 0, bytes: 0 }),
+    ]);
+    expect(summary).toEqual({ kept: 1, bytes: 1300, notReady: ["/b", "/c"], silent: ["/d"], full: true });
+  });
+});
