diff --git a/components/projects/keep-offline.tsx b/components/projects/keep-offline.tsx
new file mode 100644
index 0000000..80d6a66
--- /dev/null
+++ b/components/projects/keep-offline.tsx
@@ -0,0 +1,143 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+import { useI18n } from "@/components/layout/locale-provider";
+import { Button } from "@/components/ui/button";
+import { useKeptStudios } from "@/hooks/use-kept-studios";
+import { studios } from "@/lib/navigation";
+import { keepStudios, summarize, type KeepSummary } from "@/lib/pwa/keep-studios";
+import { formatBytes } from "@/lib/svg-size";
+
+type Progress = { current: number; total: number; bytes: number };
+
+/**
+ * Keeps studios for offline use now, for someone about to lose their connection. A studio is otherwise kept the
+ * first time it is opened. Nothing is downloaded until the person presses the button.
+ */
+export function KeepOffline({ onKept }: { onKept?: () => void }) {
+  const { t, plural } = useI18n();
+  const { kept } = useKeptStudios();
+  const [worker, setWorker] = useState<ServiceWorker | null>(null);
+  const [selected, setSelected] = useState<ReadonlySet<string>>(new Set());
+  const [progress, setProgress] = useState<Progress | null>(null);
+  const [summary, setSummary] = useState<KeepSummary | null>(null);
+
+  // The worker answers only once it controls the page: not in development, and not before the first reload.
+  useEffect(() => {
+    if (!("serviceWorker" in navigator)) return;
+    const read = () => setWorker(navigator.serviceWorker.controller);
+    read();
+    navigator.serviceWorker.addEventListener("controllerchange", read);
+    return () => navigator.serviceWorker.removeEventListener("controllerchange", read);
+  }, []);
+
+  const name = (href: string) => {
+    const studio = studios.find((item) => item.href === href);
+    return studio ? t(`studio.${studio.id}.short`) : href;
+  };
+  const names = (hrefs: readonly string[]) => hrefs.map(name).join(", ");
+  const busy = progress !== null;
+  const pending = studios.filter((studio) => !kept.has(studio.href) && selected.has(studio.href));
+
+  function toggle(href: string) {
+    const next = new Set(selected);
+    if (!next.delete(href)) next.add(href);
+    setSelected(next);
+  }
+
+  async function keep() {
+    if (!worker || pending.length === 0) return;
+    setSummary(null);
+    setProgress({ current: 1, total: pending.length, bytes: 0 });
+    const results = await keepStudios(
+      worker,
+      pending.map((studio) => studio.href),
+      setProgress,
+    );
+    setProgress(null);
+    setSummary(summarize(results));
+    // What did not make it stays selected, so one more press tries again.
+    setSelected(new Set(results.filter((result) => result.status !== "kept").map((result) => result.pathname)));
+    onKept?.();
+  }
+
+  return (
+    <section aria-labelledby="keep-offline-title" className="flex flex-col gap-2 border-t pt-2">
+      <h3 id="keep-offline-title" className="text-xs font-medium">
+        {t("projects.storage.keep.title")}
+      </h3>
+      <p className="text-xs text-muted-foreground">{t("projects.storage.keep.description")}</p>
+      {worker ? (
+        <>
+          <ul className="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-2">
+            {studios.map((studio) => {
+              const isKept = kept.has(studio.href);
+              const id = `keep-offline-${studio.id}`;
+              return (
+                <li key={studio.id} className="flex items-center gap-2">
+                  <input
+                    id={id}
+                    type="checkbox"
+                    className="size-4 accent-primary"
+                    aria-describedby={`${id}-state`}
+                    checked={isKept || selected.has(studio.href)}
+                    disabled={isKept || busy}
+                    onChange={() => toggle(studio.href)}
+                  />
+                  <label htmlFor={id} className="flex-1 truncate">
+                    {t(`studio.${studio.id}.short`)}
+                  </label>
+                  <span id={`${id}-state`} className="shrink-0 text-xs text-muted-foreground">
+                    {isKept ? t("projects.storage.keep.kept") : t("projects.storage.keep.notKept")}
+                  </span>
+                </li>
+              );
+            })}
+          </ul>
+          <div className="flex flex-wrap items-center gap-2">
+            <Button
+              variant="outline"
+              size="sm"
+              disabled={busy}
+              onClick={() =>
+                setSelected(new Set(studios.filter((studio) => !kept.has(studio.href)).map((studio) => studio.href)))
+              }
+            >
+              {t("projects.storage.keep.selectAll")}
+            </Button>
+            <Button size="sm" disabled={busy || pending.length === 0} onClick={() => void keep()}>
+              {t("projects.storage.keep.button")}
+            </Button>
+          </div>
+        </>
+      ) : (
+        <p className="text-xs text-muted-foreground">{t("projects.storage.keep.unavailable")}</p>
+      )}
+      <div role="status" className="flex flex-col gap-1 text-xs">
+        {progress ? (
+          <p>
+            {t("projects.storage.keep.progress", {
+              current: progress.current,
+              total: progress.total,
+              size: formatBytes(progress.bytes),
+            })}
+          </p>
+        ) : null}
+        {summary && summary.kept > 0 ? (
+          <p>{plural("projects.storage.keep.done", summary.kept, { size: formatBytes(summary.bytes) })}</p>
+        ) : null}
+        {summary && summary.notReady.length > 0 ? (
+          <p>
+            {t(summary.full ? "projects.storage.keep.full" : "projects.storage.keep.failed", {
+              studios: names(summary.notReady),
+            })}
+          </p>
+        ) : null}
+        {summary && summary.silent.length > 0 ? (
+          <p>{t("projects.storage.keep.silent", { studios: names(summary.silent) })}</p>
+        ) : null}
+      </div>
+    </section>
+  );
+}
