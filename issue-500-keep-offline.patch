--- /dev/null
+++ b/lib/pwa/keep-studios.ts
@@ -0,0 +1,111 @@
+/** The window event fired when a studio has been kept, so the sidebar and the studio chooser look again. */
+export const KEPT_STUDIOS_EVENT = "designhub:kept-studios";
+
+/** How long to wait for the worker to answer for one studio. A studio is a few hundred kB, so this is generous. */
+const ANSWER_TIMEOUT = 60_000;
+
+/** What the worker did for one studio. `silent` means no answer came, so nothing is known about it. */
+export type KeepResult = {
+  pathname: string;
+  status: "kept" | "failed" | "unknown" | "silent";
+  /** Files stored by this request (none when the studio was already kept). */
+  files: number;
+  /** Bytes stored by this request. */
+  bytes: number;
+  /** Files that were not stored: a download that failed, or no room left on the device. */
+  failed: number;
+  /** True when the device ran out of room for at least one file. */
+  full: boolean;
+};
+
+export type KeepSummary = {
+  /** Studios that are now ready offline. */
+  kept: number;
+  bytes: number;
+  /** Studios that are not ready: a file could not be stored, or the worker does not know the studio. */
+  notReady: string[];
+  /** Studios the worker never answered for. */
+  silent: string[];
+  full: boolean;
+};
+
+type Worker = Pick<ServiceWorker, "postMessage">;
+
+const silent = (pathname: string): KeepResult => ({
+  pathname,
+  status: "silent",
+  files: 0,
+  bytes: 0,
+  failed: 0,
+  full: false,
+});
+
+/** Reads the worker's answer, which is data from another context: anything unexpected counts as a failure. */
+function readResult(pathname: string, data: unknown): KeepResult {
+  if (typeof data !== "object" || data === null) return silent(pathname);
+  const answer = data as Record<string, unknown>;
+  const count = (value: unknown) => (typeof value === "number" && Number.isFinite(value) && value >= 0 ? value : 0);
+  const status = answer.status === "kept" || answer.status === "unknown" ? answer.status : "failed";
+  return {
+    pathname,
+    status,
+    files: count(answer.files),
+    bytes: count(answer.bytes),
+    failed: count(answer.failed),
+    full: answer.full === true,
+  };
+}
+
+/** Asks the worker to keep one studio now and waits for its answer. Never rejects. */
+export function keepStudio(worker: Worker, pathname: string, timeout = ANSWER_TIMEOUT): Promise<KeepResult> {
+  return new Promise((resolve) => {
+    const channel = new MessageChannel();
+    const timer = setTimeout(() => finish(silent(pathname)), timeout);
+    function finish(result: KeepResult) {
+      clearTimeout(timer);
+      channel.port1.close();
+      resolve(result);
+    }
+    channel.port1.onmessage = (event: MessageEvent<unknown>) => finish(readResult(pathname, event.data));
+    try {
+      worker.postMessage({ type: "REMEMBER_ROUTE", pathname }, [channel.port2]);
+    } catch {
+      finish(silent(pathname));
+    }
+  });
+}
+
+/**
+ * Keeps the given studios one after the other, one message each, so the connection is not shared by all of them at
+ * once and the person can see how far it has got. `onProgress` is called before each studio, with the bytes stored
+ * so far. Each studio that is kept tells the page, so the sidebar marker appears as it goes.
+ */
+export async function keepStudios(
+  worker: Worker,
+  pathnames: readonly string[],
+  onProgress?: (progress: { current: number; total: number; bytes: number }) => void,
+  timeout?: number,
+): Promise<KeepResult[]> {
+  const results: KeepResult[] = [];
+  let bytes = 0;
+  for (const pathname of pathnames) {
+    onProgress?.({ current: results.length + 1, total: pathnames.length, bytes });
+    const result = await keepStudio(worker, pathname, timeout);
+    results.push(result);
+    bytes += result.bytes;
+    if (typeof window !== "undefined") window.dispatchEvent(new Event(KEPT_STUDIOS_EVENT));
+  }
+  return results;
+}
+
+export function summarize(results: readonly KeepResult[]): KeepSummary {
+  return {
+    kept: results.filter((result) => result.status === "kept").length,
+    bytes: results.reduce((total, result) => total + result.bytes, 0),
+    notReady: results
+      .filter((result) => result.status === "failed" || result.status === "unknown")
+      .map((result) => result.pathname),
+    silent: results.filter((result) => result.status === "silent").map((result) => result.pathname),
+    full: results.some((result) => result.full),
+  };
+}
